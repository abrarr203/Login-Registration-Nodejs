<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
 <div class="wrapper">
<!-- {{!----------------------------- Form box -----------------------------------}} -->
    <div class="form-box">
        <!-- {{!------------------- registration form --------------------------}} -->
        <div class="login-container" id="signup">
            <form action="/api/v1/auth/sign-in" method="post">
                <div class="top">
                    <header>Sign Up</header>
                </div>
                <div class="input-box">
                    <input type="text" class="input-field" id="loginId" name="loginId" placeholder="Email / Username" required>
                    <i class="bx bx-envelope"></i>
                </div>
                <div class="input-box">
                    <input type="password" class="input-field" id="password" name="password" placeholder="Password" max="20" min="8" required>
                    <i class="bx bx-lock-alt"></i>
                </div>
                <div class="input-box">
                    <input type="submit" class="submit" value="SignUp">
                </div>
                <div class="two-col">
                    <div class="two">
                        <span>Have an account? <label><a href="/api/v1/auth/login">Login</a></label></span>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>   
</body>
</html>